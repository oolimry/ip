<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="400.0"
         type="javafx.scene.layout.HBox"
         spacing="10.0"
         style="-fx-background-color: #000000;"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity"
               style="-fx-background-color: #1a1a1a;
                      -fx-text-fill: #33FF00;
                      -fx-font-family: 'Courier New';
                      -fx-border-color: #33FF00;
                      -fx-border-width: 1;
                      -fx-padding: 10;">
            <HBox.margin>
                <Insets top="5.0" />
            </HBox.margin>
        </Label>
        <ImageView fx:id="displayPicture" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true"
                   style="-fx-effect: dropshadow(three-pass-box, #33FF00, 5, 0, 0, 0);" />
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</fx:root>