<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="400.0"
            style="-fx-background-color: #000000; -fx-border-color: #33FF00; -fx-border-width: 2;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.MainWindow">
    <children>


        <TextField fx:id="userInput"
                   layoutY="558.0"
                   onAction="#handleEnterPressed"
                   prefHeight="41.0"
                   prefWidth="315.0"
                   style="-fx-background-color: #000000;
                          -fx-text-fill: #33FF00;
                          -fx-border-color: #33FF00;
                          -fx-font-family: 'Courier New';"
                   AnchorPane.bottomAnchor="5.0"
                   AnchorPane.leftAnchor="5.0" />

        <Button fx:id="sendButton"
                layoutX="324.0"
                layoutY="553.0"
                mnemonicParsing="false"
                onAction="#handleEnterPressed"
                prefHeight="41.0"
                prefWidth="70.0"
                text="EXE"
                style="-fx-background-color: #33FF00;
                       -fx-text-fill: #000000;
                       -fx-font-weight: bold;
                       -fx-font-size: 12px;
                       -fx-font-family: 'Courier New';
                       -fx-background-radius: 0;"
                AnchorPane.bottomAnchor="5.0"
                AnchorPane.rightAnchor="5.0" />

        <ScrollPane fx:id="scrollPane"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    prefHeight="540.0"
                    prefWidth="390.0"
                    vvalue="1.0"
                    style="-fx-background: #000000; -fx-background-color: #000000; -fx-border-color: #33FF00;"
                    AnchorPane.topAnchor="5.0"
                    AnchorPane.leftAnchor="5.0">
            <content>
                <VBox fx:id="dialogContainer"
                      prefWidth="375.0"
                      style="-fx-background-color: #000000;" />
            </content>
        </ScrollPane>

        <Label fx:id="autocompleteList"
               visible="false"
               wrapText="false"
               style="-fx-background-color: #000000;
              -fx-text-fill: #788C73;
              -fx-border-color: #000000;
              -fx-border-width: 1;
              -fx-padding: 5 10 5 10;
              -fx-font-family: 'Courier New';
              -fx-font-size: 12px;
              -fx-opacity: 0.9;"
               AnchorPane.bottomAnchor="50.0"
               AnchorPane.leftAnchor="5.0" />
    </children>
</AnchorPane>